name: Cesium colapse
description: You have slower reload and poisonous effect because tiny pieces of Cesium had penetrated your armor and as they collapse they are messing with units
details: Thanks to realfndragon for the name
speedMultiplier: 0.35
reloadMultiplier: 0.75
damage: 0.25
effect: {
	type: MultiEffect
	effects:[
	{
	type: ParticleEffect,
	colorFrom: ffaaaa
	colorTo: ffffff
	sizeFrom: 1
	sizeTo: 0
	particles: 9
	length: 0
	cone: 360
	}
	]
}
